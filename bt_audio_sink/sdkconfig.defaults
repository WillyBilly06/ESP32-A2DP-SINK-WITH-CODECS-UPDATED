# =============================================================
# ESP32 A2DP Sink - Internal RAM Only (NO PSRAM)
# Codecs: SBC, AAC, aptX/aptX-HD, LDAC, Opus. LC3plus disabled to save RAM.
# =============================================================

# Flash
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y

# Compiler: max performance, no assertion overhead
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_COMPILER_OPTIMIZATION_ASSERTIONS_DISABLE=y

# Scheduler: 1 kHz tick for fine-grained scheduling. The A2DP decoder task
# (core 1, below the BT controller) and the audio_render task must resume
# within ~1 ms after preemption; at the default 100 Hz the 10 ms quantum
# turns controller/BLE preemption into ~10 ms decode bursts -> ring underruns.
CONFIG_FREERTOS_HZ=1000

# ---- Bluetooth ----
CONFIG_BT_ENABLED=y
CONFIG_BT_CLASSIC_ENABLED=y
CONFIG_BT_A2DP_ENABLE=y
CONFIG_BT_A2DP_APTX_DECODER=y
CONFIG_BT_A2DP_LDAC_DECODER=y
CONFIG_BT_A2DP_OPUS_DECODER=y
# CONFIG_BT_A2DP_LC3PLUS_DECODER is not set
CONFIG_BT_A2DP_AAC_DECODER=y
CONFIG_BT_BLE_ENABLED=y
# CONFIG_BT_BLE_42_DTM_TEST_EN is not set
# CONFIG_BT_BLE_42_SCAN_EN is not set
CONFIG_BTDM_CTRL_MODE_BTDM=y
CONFIG_BTDM_CTRL_AUTO_LATENCY=y
CONFIG_BTDM_CTRL_LEGACY_AUTH_VENDOR_EVT=y

# BT task stacks - minimized for A2DP sink
CONFIG_BT_BTC_TASK_STACK_SIZE=3584
CONFIG_BT_BTU_TASK_STACK_SIZE=3584

# ---- BT Memory Optimization ----
# One Classic BR/EDR A2DP connection plus one BLE GATT connection.
CONFIG_BT_ACL_CONNECTIONS=2
CONFIG_BT_MULTI_CONNECTION_ENBALE=y

# Controller connection limits
CONFIG_BTDM_CTRL_BLE_MAX_CONN=1
CONFIG_BTDM_CTRL_BR_EDR_MAX_ACL_CONN=1
CONFIG_BTDM_CTRL_BR_EDR_MAX_SYNC_CONN=0

# Dedicated Bluetooth/low-latency core.
# CONFIG_BT_BLUEDROID_PINNED_TO_CORE_0 is not set
CONFIG_BT_BLUEDROID_PINNED_TO_CORE_1=y
# CONFIG_BTDM_CTRL_PINNED_TO_CORE_0 is not set
CONFIG_BTDM_CTRL_PINNED_TO_CORE_1=y

# GATT Server sizing. MAX_SR_PROFILES sizes the per-service slot pool
# (gatt_cb.hdl_list / sr_reg / srv_list and BTA srvc_cb). It must hold ALL GATT
# server services: the stack's internal GAP (0x1800) and GATT/Service-Changed
# (0x1801) services, PLUS extra internal services the stack stands up when
# MULTI_CONNECTION is enabled (needed for simultaneous BLE + A2DP), PLUS our
# unified app service. At 2 there was no free slot, so esp_ble_gatts_create_service
# came back via CREATE_EVT with ESP_GATT_ERROR (status 0x85): the service got a
# garbage handle and NO characteristics could be added (app reported "incompatible
# firmware"). 5 leaves comfortable headroom and is confirmed working on-device.
# Non-writable GAP name/appearance keeps the GAP attribute count small.
CONFIG_BT_GATT_MAX_SR_PROFILES=5
CONFIG_BT_GATT_MAX_SR_ATTRIBUTES=40
CONFIG_BT_GATTS_PPCP_CHAR_GAP=y
# CONFIG_BT_GATTS_DEVICE_NAME_WRITABLE is not set
# CONFIG_BT_GATTS_APPEARANCE_WRITABLE is not set

# BLE app only uses the GATT server; keep GATTC off to save RAM.
# CONFIG_BT_GATTC_ENABLE is not set

# Bond storage (match original: 15)
CONFIG_BT_SMP_MAX_BONDS=1

# BLE dynamic env memory
CONFIG_BT_BLE_DYNAMIC_ENV_MEMORY=y

# BLE scan dedup: 20 is plenty
CONFIG_BTDM_SCAN_DUPL_CACHE_SIZE=10

# No BLE scanning in the phone-control firmware.
# CONFIG_BTDM_CTRL_FULL_SCAN_SUPPORTED is not set

# BLE adv report flow control (match original: 100)
CONFIG_BTDM_BLE_ADV_REPORT_FLOW_CTRL_NUM=50

# BLE meter notifications are useful but should not compete with A2DP audio.
CONFIG_LEVELS_UPDATE_MS=30

# Secondary WM8805 I2S-to-S/PDIF output
CONFIG_SPDIF_I2S_ENABLE=y
CONFIG_SPDIF_I2S_MCLK_PIN=0
CONFIG_SPDIF_I2S_BCK_PIN=32
CONFIG_SPDIF_I2S_LRCK_PIN=33
CONFIG_SPDIF_I2S_DATA_PIN=13

# Disable BT debug logs for production (saves rodata/flash)
CONFIG_BT_STACK_NO_LOG=y

# NO PSRAM - all allocations in internal SRAM
# CONFIG_SPIRAM is not set
# CONFIG_BT_ALLOCATION_FROM_SPIRAM_FIRST is not set

# OTA Rollback
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
CONFIG_APP_ROLLBACK_ENABLE=y

# Disable unused peripherals
CONFIG_TWAI_ERRATA_FIX_BUS_OFF_REC=n
CONFIG_TWAI_ERRATA_FIX_TX_INTR_LOST=n
CONFIG_TWAI_ERRATA_FIX_RX_FRAME_INVALID=n
CONFIG_TWAI_ERRATA_FIX_RX_FIFO_CORRUPT=n

# System
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESP32_REV_MIN_1=y
# Keep CPU/radio clocks stable for continuous A2DP + BLE coexistence.
# CONFIG_ESP_PHY_REDUCE_TX_POWER is not set
# CONFIG_PM_ENABLE is not set
# CONFIG_BTDM_CTRL_MODEM_SLEEP is not set

# Watchdog: allow extra time for LDAC 96kHz decode
CONFIG_ESP_INT_WDT_TIMEOUT_MS=800
CONFIG_ESP_TASK_WDT_TIMEOUT_S=10
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU1=n

# Timer task stack - increased to prevent overflow with BT timers + heap logging
CONFIG_FREERTOS_TIMER_TASK_STACK_DEPTH=4096

# Minimize IPC stack (only used for cross-core calls)
CONFIG_ESP_IPC_TASK_STACK_SIZE=1536

# WiFi (for OTA) - static TX buffers use less heap
CONFIG_ESP_WIFI_STATIC_TX_BUFFER=y
CONFIG_ESP_WIFI_IRAM_OPT=y
CONFIG_ESP_WIFI_RX_IRAM_OPT=y

# HTTP/OTA
CONFIG_ESP_HTTP_CLIENT_ENABLE_DIGEST_AUTH=y

# FreeRTOS
CONFIG_FREERTOS_ENABLE_BACKWARD_COMPATIBILITY=y
CONFIG_FREERTOS_PLACE_SNAPSHOT_FUNS_INTO_FLASH=y

# LWIP: small TCP windows for OTA (not streaming)
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=5744
CONFIG_LWIP_TCP_WND_DEFAULT=5744

# TLS
CONFIG_MBEDTLS_GCM_SUPPORT_NON_AES_CIPHER=y
CONFIG_ESP_PROTOCOMM_SUPPORT_SECURITY_VERSION_2=n
CONFIG_WIFI_PROV_BLE_FORCE_ENCRYPTION=y

# DSP: enable processing with internal-RAM-friendly buffer sizes
# AUDIO_POOL_COUNT * AUDIO_POOL_BUF_SIZE = Q1.31 stereo jitter ring (8 bytes/frame).
# 16 * 1024 = 16 KB = 2048 frames. Logs show steady-state fill never exceeds
# ~1023 frames even at LDAC 96k, so 2048 frames keeps full headroom while
# returning 8 KB of internal RAM to the BT/BLE stack (fixes heap starvation
# that broke GATT service discovery / CCCD during LDAC streaming).
CONFIG_DSP_ENABLE=y
CONFIG_DSP_OUT_FRAMES=256
CONFIG_AUDIO_POOL_COUNT=16
CONFIG_AUDIO_POOL_BUF_SIZE=1024

# Disable Ethernet (not used)
CONFIG_ETH_USE_ESP32_EMAC=n
CONFIG_ETH_USE_SPI_ETHERNET=n
# CONFIG_BT_AVRCP_CT_COVER_ART_ENABLED is not set
# CONFIG_BT_GOEPC_ENABLED is not set
