# Inspect the actual component recipe without configuring or changing the
# shared ESP-IDF project. The target compile uses this emitted source list.
function(idf_build_get_property result property)
    if(NOT property STREQUAL "PYTHON")
        message(FATAL_ERROR "Unexpected IDF property")
    endif()
    set(${result} "${HOST_PYTHON}" PARENT_SCOPE)
endfunction()
function(idf_component_register)
    cmake_parse_arguments(COMP "" "" "SRCS;INCLUDE_DIRS;PRIV_INCLUDE_DIRS;REQUIRES;PRIV_REQUIRES" ${ARGN})
    foreach(field SRCS INCLUDE_DIRS PRIV_INCLUDE_DIRS REQUIRES PRIV_REQUIRES)
        foreach(value IN LISTS COMP_${field})
            file(APPEND "${MANIFEST}" "${field}|${value}\n")
        endforeach()
    endforeach()
    set(COMPONENT_LIB codec_test PARENT_SCOPE)
endfunction()
function(target_compile_definitions target)
    foreach(value IN LISTS ARGN)
        file(APPEND "${MANIFEST}" "DEFINITION|${value}\n")
    endforeach()
endfunction()
function(target_compile_options target)
    foreach(value IN LISTS ARGN)
        file(APPEND "${MANIFEST}" "OPTION|${value}\n")
    endforeach()
endfunction()
function(set_source_files_properties)
    set(values ${ARGN})
    list(FIND values "PROPERTIES" marker)
    if(marker LESS 1)
        message(FATAL_ERROR "Unsupported source property declaration")
    endif()
    list(SUBLIST values 0 ${marker} sources)
    math(EXPR property_at "${marker}+1")
    list(GET values ${property_at} property)
    if(NOT property STREQUAL "COMPILE_OPTIONS")
        message(FATAL_ERROR "Unexpected source property")
    endif()
    math(EXPR option_at "${marker}+2")
    list(SUBLIST values ${option_at} -1 options)
    foreach(source IN LISTS sources)
        foreach(option IN LISTS options)
            file(APPEND "${MANIFEST}" "SOURCE_OPTION|${source}|${option}\n")
        endforeach()
    endforeach()
endfunction()
file(WRITE "${MANIFEST}" "")
include("${RECIPE}")
